// Cloudflare Worker config. See BACKEND-PLAN.md for the full design.
//
// This branch targets the NEW account (the one that owns
// qualitativeinterviewskills.com). The account, the database and the
// sending domain all differ from the 2026-09-15 production deployment;
// PROTOCOLS.md records the move.
//
// Secrets are NOT here. Set with `wrangler secret put <NAME>`:
//   SESSION_SECRET   HMAC key for the signed session cookie (§6)
// Mail needs no key since 2026-09-18: Cloudflare Email Service sends
// through the `send_email` binding below. The domain in EMAIL_FROM must be
// onboarded once per account (DEPLOYMENT.md §4).
// The university AI gateway key is NOT a secret either: it lives in the
// `settings` table (row `openai_api_key`), write-only from /api/admin, so it
// can be rotated from the dashboard without a deploy. See BACKEND-PLAN.md §7.
{
  "name": "research-interview-trainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The app answers on the domain only. The workers.dev address is off, so
  // there is one address to protect with Access and one to give students.
  "routes": [{ "pattern": "qualitativeinterviewskills.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare Email Service. The binding may only send as this address, so
  // a mistake elsewhere cannot mail students from some other sender.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["trainer@qualitativeinterviewskills.com"]
    }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "riv-trainer", "database_id": "81264e33-443c-45ec-8593-3db6c01acd16" }
  ],
  "vars": {
    // Empty until Zero Trust is set up in the new account. worker/access.ts
    // fails CLOSED while these are unset: every /api/admin/* request is
    // refused, which is the correct state before the Access app exists.
    // Fill both from the new Access application, then redeploy.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "EMAIL_FROM": "Qualitative Interview Skills <trainer@qualitativeinterviewskills.com>",
    // The university AI gateway (Tilburg.AI: LiteLLM in front of Azure OpenAI).
    // Every AI call goes here, and the browser's WebRTC call address is built
    // from it. The testing gateway is https://api.testing.tilburg.ai/v1.
    "AI_BASE_URL": "https://api.tilburg.ai/v1"
  },
  "observability": { "enabled": true }
}
