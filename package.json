{
  "name": "research-interview-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "seed:gen": "esbuild worker/genseed.ts --bundle --platform=node --format=esm --outfile=.genseed.mjs && node .genseed.mjs > seed-personas.sql && rm .genseed.mjs",
    "seed:gen:criteria": "esbuild worker/genseed-criteria.ts --bundle --platform=node --format=esm --outfile=.genseed-criteria.mjs && node .genseed-criteria.mjs > seed-criteria.sql && rm .genseed-criteria.mjs",
    "backup": "wrangler d1 export riv-trainer --remote --output=backup-$(date +%F).sql",
    "backup:local": "wrangler d1 export riv-trainer --local --output=backup-local-$(date +%F).sql"
  },
  "dependencies": {
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.123.0"
  }
}
